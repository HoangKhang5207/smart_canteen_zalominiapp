# =============================================================================
# MODE 3 — CHAY TREN ZALO MOBILE (Zalo Mini App Development / Testing)
# Su dung: Copy-Item .env.zalo.example .env -> dien domain HTTPS & APP_ID
#          npm run build -> npm run deploy (hoac Deploy Testing trong Zalo Studio)
# =============================================================================
# Bat buoc la HTTPS cong khai cua Backend (Cloudflare Tunnel hoac VPS co SSL)
VITE_API_BASE_URL=https://YOUR_HTTPS_DOMAIN/api/v1

# Tat nut Dang nhap Demo de buoc dung xac thuc SDT Zalo that (zmp-sdk getPhoneNumber)
VITE_DEMO_PHONE_LOGIN=false

# Mini App ID lay tu https://mini.zalo.me/developers/
APP_ID=YOUR_ZALO_MINI_APP_ID
ZMP_TOKEN=
